{
  "name": "preload-it",
  "version": "2.0.0",
  "description": "A small JavaScript library for preloading browser assets with composite progress events.",
  "author": "Andreu Pifarre",
  "license": "MIT",
  "repository": "https://github.com/andreupifarre/preload-it",
  "bugs": "https://github.com/andreupifarre/preload-it/issues",
  "keywords": [
    "preload",
    "preloading",
    "xhr",
    "assets",
    "library",
    "es6",
    "videos",
    "images",
    "load"
  ],
  "unpkg": "dist/preload-it.min.js",
  "main": "dist/preload-it.js",
  "module": "dist/preload-it.esm.js",
  "browser": "dist/preload-it.js",
  "types": "index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./dist/preload-it.esm.mjs",
      "require": "./dist/preload-it.js",
      "default": "./dist/preload-it.js"
    },
    "./dist/*": "./dist/*",
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "dependencies": {},
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@rollup/plugin-terser": "^1.0.0",
    "rollup": "^4.63.1",
    "typescript": "^7.0.2"
  },
  "scripts": {
    "build": "rollup -c rollup.config.mjs",
    "dev": "rollup -c rollup.config.mjs -w",
    "test": "npm run test:types && playwright test",
    "test:browser": "playwright test",
    "test:server": "node test/server.mjs",
    "test:types": "tsc --noEmit -p test/tsconfig.json",
    "pretest": "npm run build",
    "pack:check": "npm pack --dry-run"
  },
  "files": [
    "dist",
    "index.d.ts",
    "README.md",
    "CHANGELOG.md",
    "MIGRATION.md",
    "LICENSE"
  ]
}
